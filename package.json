{
  "name": "douyin-desktop",
  "version": "0.1.0",
  "description": "抖音网页端 Electron 桌面应用，内置抖音优化用户脚本。",
  "main": "app/main.js",
  "author": "yhgeo",
  "license": "GPL-3.0-only",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "package": "electron-builder --dir",
    "dist": "electron-builder --win nsis portable",
    "lint": "node --check app/main.js && node --check app/preload.js && node --check app/gm-store.js && node --check app/url-policy.js && node --check app/web-contents-guard.js && node --check app/dom-ready.js",
    "test": "node --test \"test/**/*.test.js\"",
    "test:e2e": "node tools/e2e/run-all.js",
    "test:all": "npm test && npm run test:e2e"
  },
  "build": {
    "appId": "com.yhgeo.douyin",
    "productName": "抖音",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**/*",
      "assets/**/*",
      "vendor/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "assets/**/*",
      "vendor/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/douyin-icon.png",
      "executableName": "抖音"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "electron": "44.4.3",
    "electron-builder": "26.15.3"
  }
}
